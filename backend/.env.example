GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# LLM_MOCK=1 (local UI development only)

# ── Authentication (set real values in Render / your local .env, never commit them) ──
# Random string of at least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Frontend origin(s), comma separated, no trailing slash
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001
# Google OAuth 2.0 (Google Cloud Console > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be the frontend origin + /backend/auth/google/callback (it goes through the Next.js rewrite)
OAUTH_REDIRECT_URI=http://localhost:3001/backend/auth/google/callback
# SMTP for password-reset email (optional in development: the link is printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
